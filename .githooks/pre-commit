#!/bin/sh
# [R2-02] pre-commit gate for the one regression that kept slipping through.
#
# The 401-silent wiring in src/lib/api/use-api-data.ts was reverted by a
# parallel agent's "backup + rewrite in place", and nothing noticed until
# someone happened to run `npm test`. The assertion that guards it
# (client.test.ts, "use-api-data.ts really does wire the session-lost handler
# silently") was valid the whole time — it just had no trigger. This hook is
# that trigger.
#
# Deliberately a plain POSIX sh script using git's own core.hooksPath, not
# husky: no new dependency, no `prepare` install step, and it works for
# `git commit` run by a human, a script, or an agent.
#
# The fast path is the point. Running the whole suite on every commit would
# make the hook something people learn to bypass, so:
#   - nothing staged under src/  -> exit immediately (docs-only commits are free)
#   - .r2bak/.bak staged          -> hard fail (that is the artefact itself)
#   - taboo guard                 -> ~3s, runs every time
#   - full npm test              -> only when the guarded files are staged
# Both gates can be skipped deliberately with --no-verify; what this buys is
# that the *default* path no longer depends on someone remembering.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# A backup file in the tree is the fingerprint of the overwrite-in-place
# pattern that caused the outage; refuse to let one be committed.
backup=$(printf '%s\n' "$staged" | grep -E '\.(r2bak|bak|orig|rej)$')
if [ -n "$backup" ]; then
  echo "pre-commit: 备份文件不得入库：" >&2
  printf '%s\n' "$backup" | sed 's/^/  /' >&2
  exit 1
fi

printf '%s\n' "$staged" | grep -q '^src/' || exit 0

# Lint exactly what is being committed. This is the gate that matters: the
# self-test below only proves the *rules still fire*, and a staged
# `text-zinc-500` sails straight through it. Passing the staged paths (rather
# than the whole tree) also keeps a commit touching one file from being blocked
# by an unrelated pre-existing error elsewhere.
echo "pre-commit: eslint（暂存文件）…"
lint_targets=$(printf '%s\n' "$staged" | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)
if [ -n "$lint_targets" ]; then
  # shellcheck disable=SC2086
  if ! npx eslint --no-warn-ignored $lint_targets; then
    echo "pre-commit: ESLint 未通过，提交已阻止。" >&2
    exit 1
  fi
fi

echo "pre-commit: 禁忌守卫自测…"
if ! node scripts/check-taboo-guard.mjs >/dev/null 2>&1; then
  echo "pre-commit: 禁忌守卫自测未通过（node scripts/check-taboo-guard.mjs 可见详情）" >&2
  exit 1
fi

echo "pre-commit: 禁忌守卫反向攻击…"
if ! node scripts/attack-taboo-guard.mjs >/dev/null 2>&1; then
  echo "pre-commit: 反向攻击用例未通过（node scripts/attack-taboo-guard.mjs 可见详情）" >&2
  exit 1
fi

# The 401 wiring lives here; the rest of src/ is covered by the guard above.
printf '%s\n' "$staged" | grep -qE '^src/lib/api/' || exit 0

echo "pre-commit: npm test（src/lib/api 变更）…"
if ! npm test; then
  echo "pre-commit: 测试未通过，提交已阻止。" >&2
  exit 1
fi
exit 0
